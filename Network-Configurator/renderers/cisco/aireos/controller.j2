{% elif wlan.security.protocol == 'wpa2_wpa3_transition' %}# SAE mixed mode requested; renderer remains review-gated until exact commands are approved by Vendor Rule.
{% elif wlan.security.protocol == 'wpa3' %}# WPA3-SAE requested; PMF must be required. Renderer remains review-gated.
{% endif %}config wlan enable {{ loop.index }}
{% endfor %}
