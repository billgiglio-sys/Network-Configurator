{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$title":"Network Configurator Multi-Device Project",
  "type":"object",
  "required":["schema_version","project","sites","networks","devices","interfaces","links","wireless"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "project":{"type":"object","required":["id","name","environment"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"environment":{"enum":["lab","development","staging","production"]}}},
    "sites":{"type":"object"},
    "networks":{"type":"object","additionalProperties":{"type":"object","required":["name","vlan","ipv4"],"properties":{"name":{"type":"string"},"vlan":{"type":"object","required":["id","name"],"properties":{"id":{"type":"integer","minimum":1,"maximum":4094},"name":{"type":"string"}}},"ipv4":{"type":"object","required":["subnet"],"properties":{"subnet":{"type":"string"},"gateway":{"type":["string","null"]}}}}}},
    "devices":{"type":"object","additionalProperties":{"type":"object","required":["name","vendor","category","platform","software","renderer"],"properties":{"name":{"type":"string"},"vendor":{"enum":["cisco","fortinet"]},"category":{"type":"string"},"platform":{"type":"object"},"software":{"type":"object"},"renderer":{"type":"string"},"vendor_extensions":{"type":"object"}}}},
    "interfaces":{"type":"object"},"port_profiles":{"type":"object"},"links":{"type":"array"},"relationships":{"type":"array"},"wireless":{"type":"object"},"routing":{"type":"object"},"security_policies":{"type":"array"},"validation":{"type":"object"}
  }
}
